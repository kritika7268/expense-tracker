# Database Configuration
# Default is MySQL. If MySQL is not running or credentials differ,
# the backend gracefully falls back to local SQLite (expense_tracker.db)
DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@localhost:3306/expense_tracker

# JWT Security
SECRET_KEY=change_this_secret_key_to_a_random_32_character_string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Environment
ENVIRONMENT=development
